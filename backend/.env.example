APP_NAME=EscudoSST
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Hosts y puertos para la API dentro de Docker (compose.dev.yml).
# Si corres PHP fuera de Docker usa 127.0.0.1 con los puertos 5440 / 5441 / 6380.
DB_CONNECTION=pgsql
DB_HOST=pg-main
DB_PORT=5432
DB_DATABASE=escudo_main
DB_USERNAME=escudo_api
DB_PASSWORD=escudo_api_dev

# Rol dueño, solo para: php artisan migrate --database=pgsql_owner
DB_OWNER_USERNAME=escudo_owner_login
DB_OWNER_PASSWORD=escudo_owner_dev

# Panel interno del dueño de la plataforma (rol escudo_platform)
DB_PLATFORM_USERNAME=escudo_platform_login
DB_PLATFORM_PASSWORD=escudo_platform_dev

DB_MEDICAL_HOST=pg-medical
DB_MEDICAL_PORT=5432
DB_MEDICAL_DATABASE=escudo_medical
DB_MEDICAL_USERNAME=escudo_med_api
DB_MEDICAL_PASSWORD=escudo_med_api_dev

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo. En desarrollo todo llega a Mailpit (http://localhost:8026), no sale a internet.
# Para enviar de verdad con Gmail (pruebas): comenta el bloque de Mailpit y usa el de Gmail
# con una «contraseña de aplicación» de Google (ver README, sección Correo).
# En producción el proveedor es Elastic Email (docs/01-arquitectura.md).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="notificaciones@escudosst.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Gmail (descomenta y reemplaza; MAIL_FROM_ADDRESS debe ser la misma cuenta) ---
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=null
# MAIL_USERNAME=tu.cuenta@gmail.com
# MAIL_PASSWORD="contraseña de aplicación de 16 letras"
# MAIL_FROM_ADDRESS="tu.cuenta@gmail.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Frontend (enlaces en correos)
FRONTEND_URL=http://localhost:3000

# Copias de seguridad (docs/15 §9). Generar llaves con: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
# Guardar una copia de las llaves fuera del servidor: sin ellas las copias no se pueden abrir.
DB_BACKUP_USERNAME=escudo_backup
DB_BACKUP_PASSWORD=
BACKUP_KEY=
BACKUP_MEDICAL_KEY=
BACKUP_DISK=backups
BACKUP_RETENTION_DAYS=30
BACKUP_DAILY_AT=02:30
APP_TIMEZONE=America/Lima
AUTH_IDLE_MINUTES=30

# Google Calendar para la agenda de demos (Google Cloud → Credenciales → ID de cliente OAuth «Aplicación web»).
# Dirección de retorno autorizada: ${APP_URL}/api/v1/public/demo/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Producción: true para que las páginas armadas por el servidor de Next (red interna de Docker) no gasten el límite anti-abuso.
THROTTLE_TRUST_INTERNAL=false
