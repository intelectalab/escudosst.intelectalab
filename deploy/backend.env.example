# Secretos y ajustes de PRODUCCIÓN de EscudoSST.
# En el servidor: copiar a deploy/backend.env y completar. Ese archivo NO va a git (está en .gitignore).
# Las contraseñas y llaves se generan nuevas para producción: NUNCA reutilizar las de desarrollo.
# Para generar una contraseña o llave larga en el servidor:   openssl rand -base64 36 | tr -d '/+=' | cut -c1-40

APP_NAME=EscudoSST
APP_ENV=production
APP_DEBUG=false
# Se genera en el servidor con:  ./deploy/escudo.sh artisan key:generate --show   (y se pega aquí)
APP_KEY=
APP_URL=https://escudosst.intelectalab.com
FRONTEND_URL=https://escudosst.intelectalab.com
APP_TIMEZONE=America/Lima
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Superusuario de PostgreSQL (solo lo usan los contenedores de base de datos al crearse).
POSTGRES_SUPERUSER_PASSWORD=

# Base principal (los usuarios se crean solos la primera vez con estas contraseñas).
DB_CONNECTION=pgsql
DB_HOST=pg-main
DB_PORT=5432
DB_DATABASE=escudo_main
DB_USERNAME=escudo_api
DB_PASSWORD=
DB_OWNER_USERNAME=escudo_owner_login
DB_OWNER_PASSWORD=
DB_PLATFORM_USERNAME=escudo_platform_login
DB_PLATFORM_PASSWORD=

# Base médica (separada).
DB_MEDICAL_HOST=pg-medical
DB_MEDICAL_PORT=5432
DB_MEDICAL_DATABASE=escudo_medical
DB_MEDICAL_USERNAME=escudo_med_api
DB_MEDICAL_PASSWORD=

# Copias de seguridad cifradas (dos llaves distintas; guárdalas TAMBIÉN fuera del servidor: sin ellas no se restaura).
# Generar cada una con:  echo "base64:$(openssl rand -base64 32)"   (debe empezar con base64:)
DB_BACKUP_USERNAME=escudo_backup
DB_BACKUP_PASSWORD=
BACKUP_KEY=
BACKUP_MEDICAL_KEY=
BACKUP_DISK=backups
BACKUP_RETENTION_DAYS=30
BACKUP_DAILY_AT=02:30

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
AUTH_IDLE_MINUTES=30

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
SITE_ASSETS_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# Correo real (el mismo de desarrollo: escudosst@intelectalab.com por mail.intelectalab.com).
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.intelectalab.com
MAIL_PORT=465
MAIL_USERNAME=escudosst@intelectalab.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=escudosst@intelectalab.com
MAIL_FROM_NAME=EscudoSST

# Las páginas que arma el servidor del sitio (red interna de Docker) no gastan el límite anti-abuso de los visitantes.
THROTTLE_TRUST_INTERNAL=true

# Opcionales (ver PASOS-CONEXIONES.local.md): Google Calendar para la agenda y Fidelia para el CRM.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FIDELIA_API_KEY=

# Reseñas de Google (Sitio web › Reseñas): llave de la API de Places (Google Cloud). Vacía = no se muestran reseñas.
GOOGLE_PLACES_API_KEY=
